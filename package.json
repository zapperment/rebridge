{
  "name": "rebridge",
  "description": "Use your Novation gear with Reason as stand-alone DAW",
  "scripts": {
    "log": "node src/logReceiver/index.js",
    "extract:combi": "node scripts/extractCombinatorLabels.js",
    "extract:reason-factory": "./scripts/extract-reason-factory-combinators.sh",
    "build": "yarn build:lcxl3",
    "build:dev": "yarn build:lcxl3 --dev",
    "build:lcxl3": "./build.sh LCXL3",
    "build:lcxl3:dev": "./build.sh LCXL3 --dev",
    "build:lppmk3": "./build.sh LPPMK3",
    "build:lppmk3:dev": "./build.sh LPPMK3 --dev",
    "sync": "./sync.sh",
    "setup": "yarn setup:lcxl3",
    "setup:dev": "yarn setup:lcxl3:dev",
    "setup:lppmk3": "yarn build:lppmk3 && yarn sync",
    "setup:lppmk3:dev": "yarn build:lppmk3:dev && yarn sync",
    "setup:lcxl3": "yarn build:lcxl3 && yarn sync",
    "setup:lcxl3:dev": "yarn build:lcxl3:dev && yarn sync",
    "test": "node scripts/extractCombinatorLabels.js --self-test && lua ./test/_.test.lua -v"
  },
  "packageManager": "yarn@4.14.1",
  "dependencies": {
    "easymidi": "^3.2.0",
    "luabundler": "^1.2.3"
  }
}
