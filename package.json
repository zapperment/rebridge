{
  "name": "rebridge",
  "description": "Use your Novation gear with Reason as stand-alone DAW",
  "scripts": {
    "log": "node src/logReceiver/index.js",
    "extract:combi": "node scripts/extractCombinatorLabels.js",
    "extract:reason-factory": "./scripts/extract-reason-factory-combinators.sh",
    "build": "yarn build:lcxl3",
    "build:dev": "yarn build:lcxl3 --dev",
    "build:lcxl3": "./build.sh LCXL3",
    "build:lcxl3:dev": "./build.sh LCXL3 --dev",
    "build:lpm": "./build.sh LPM",
    "build:lpm:dev": "./build.sh LPM --dev",
    "build:lpmk2": "./build.sh LPMK2",
    "build:lpmk2:dev": "./build.sh LPMK2 --dev",
    "build:lpmmk3": "./build.sh LPMMK3",
    "build:lpmmk3:dev": "./build.sh LPMMK3 --dev",
    "build:lpp": "./build.sh LPP",
    "build:lpp:dev": "./build.sh LPP --dev",
    "build:lppmk3": "./build.sh LPPMK3",
    "build:lppmk3:dev": "./build.sh LPPMK3 --dev",
    "build:lpx": "./build.sh LPX",
    "build:lpx:dev": "./build.sh LPX --dev",
    "package:lpm": "./scripts/package-release.sh LPM",
    "package:lpmk2": "./scripts/package-release.sh LPMK2",
    "package:lpmmk3": "./scripts/package-release.sh LPMMK3",
    "package:lpp": "./scripts/package-release.sh LPP",
    "package:lppmk3": "./scripts/package-release.sh LPPMK3",
    "package:lpx": "./scripts/package-release.sh LPX",
    "sync": "./sync.sh",
    "setup": "yarn setup:lcxl3",
    "setup:dev": "yarn setup:lcxl3:dev",
    "setup:lpm": "yarn build:lpm && yarn sync",
    "setup:lpm:dev": "yarn build:lpm:dev && yarn sync",
    "setup:lpmk2": "yarn build:lpmk2 && yarn sync",
    "setup:lpmk2:dev": "yarn build:lpmk2:dev && yarn sync",
    "setup:lpmmk3": "yarn build:lpmmk3 && yarn sync",
    "setup:lpmmk3:dev": "yarn build:lpmmk3:dev && yarn sync",
    "setup:lpp": "yarn build:lpp && yarn sync",
    "setup:lpp:dev": "yarn build:lpp:dev && yarn sync",
    "setup:lppmk3": "yarn build:lppmk3 && yarn sync",
    "setup:lppmk3:dev": "yarn build:lppmk3:dev && yarn sync",
    "setup:lpx": "yarn build:lpx && yarn sync",
    "setup:lpx:dev": "yarn build:lpx:dev && yarn sync",
    "setup:lcxl3": "yarn build:lcxl3 && yarn sync",
    "setup:lcxl3:dev": "yarn build:lcxl3:dev && yarn sync",
    "test": "node scripts/extractCombinatorLabels.js --self-test && lua ./test/_.test.lua -v"
  },
  "packageManager": "yarn@4.18.1",
  "dependencies": {
    "easymidi": "^3.2.0",
    "luabundler": "^1.2.3"
  }
}
