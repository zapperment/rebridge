# --- copy this file to .env, then adjust the paths; usually replacing "user.name" with your own user name is sufficient ---

PATH_REASON_REMOTE_CODECS_NOVATION="/Users/user.name/Library/Application Support/Propellerhead Software/Remote/Codecs/Lua Codecs/Novation"
FILES_REASON_REMOTE_CODECS_NOVATION="LCXL3*.{lua,luacodec,png}"

PATH_REASON_REMOTE_MAPS_NOVATION="/Users/user.name/Library/Application Support/Propellerhead Software/Remote/Maps/Novation"
FILES_REASON_REMOTE_MAPS_NOVATION="LCXL3*.remotemap"

