#PATH_MAX_AMXD_DEV="/Users/user.name/Music/Ableton/User Library/Max Stuff"
#FILES_MAX_AMXD_DEV="ReBridge.amxd"

#PATH_MAX_AMXD_PROD="/Users/user.name/Music/Ableton/User Library/Max MIDI Effect"
