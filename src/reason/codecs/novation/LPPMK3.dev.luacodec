version = { 0, 0, 1 }

function remote_supported_control_surfaces()
  local surfaces = {
    {
      manufacturer = "Novation",
      model = "Launchpad Pro [MK3] (developer version)",
      source = "LPPMK3.lua",
      picture = "LPPMK3.png",
      in_ports = {
        { description = "Input (DAW)" },
        { description = "Input (store)", optional = true },
      },
      out_ports = {
        { description = "Output (DAW)" },
        { description = "Output (store)", optional = true },
        { description = "Output (log)" },
      },
      setup_info_text =
      "Launchpad Pro [MK3] is Novation's most powerful grid controller for producing. It gives you everything you need to create and perform your tracks. This version of the remote codec has an additional port which is used to send log messages for developers",
      has_keyboard = false
    }
  }
  return surfaces
end
